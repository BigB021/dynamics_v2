{
  "author": {
    "name": "Youssef Aitbouddroub",
    "email": "youssefaitbouddroub@gmail.com",
    "url": "https://github.com/BigB021"
  },
  "name": "dynamics-desktop",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "axios": "^1.10.0",
    "dotenv": "^17.0.0",
    "lucide-react": "^0.525.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-h5-audio-player": "^3.10.0",
    "react-router": "^7.6.3",
    "react-router-dom": "^7.6.3",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "ELECTRON_DEV=true electron .",
    "electron-build": "npm run build && electron .",
    "build-electron": "electron-builder"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.17",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.youssef.dynamics",
    "productName": "Dynamics",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build"
      },
      {
        "from": "music-server",
        "to": "music-server"
      },
      {
        "from": "music-server/node_modules",
        "to": "music-server/node_modules"
      },
      {
        "from": "venv",
        "to": "venv"
      }
    ],
    "asarUnpack": [
      "**/music-server/**/*"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "linux": {
      "icon": "public/logo.png",
      "target": [
        "AppImage"
      ]
    },
    "win": {
      "icon": "public/favicon.ico",
      "target": "nsis"
    }
  }
}
